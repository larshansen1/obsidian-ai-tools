{
  "manifest_version": 3,
  "name": "kai",
  "version": "1.0.0",
  "description": "Ingest the current page into your Obsidian vault via kai",

  "permissions": ["activeTab", "storage", "contextMenus", "scripting"],
  "host_permissions": ["http://127.0.0.1:8765/*"],

  "action": {
    "default_popup": "popup.html",
    "default_title": "kai — Ingest to Obsidian"
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open kai ingest popup"
    }
  }
}
